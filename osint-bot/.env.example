# ==========================================================
#  OSINT Bot — configuração
#  Copie este arquivo para ".env" e preencha os valores.
# ==========================================================

# OBRIGATÓRIO: token do seu bot (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=coloque_seu_token_aqui

# OPCIONAL: se preencher, os comandos de barra aparecem na hora nesse servidor.
# Pegue o ID clicando com o botão direito no seu servidor (Modo Desenvolvedor ligado).
GUILD_ID=

# ----------------------------------------------------------
#  Chaves de API OPCIONAIS (o bot funciona sem elas;
#  cada ferramenta avisa se a chave estiver faltando)
# ----------------------------------------------------------

# Shodan (https://account.shodan.io) — para /shodan
SHODAN_API_KEY=

# Have I Been Pwned (https://haveibeenpwned.com/API/Key) — para /breach por e-mail
HIBP_API_KEY=
