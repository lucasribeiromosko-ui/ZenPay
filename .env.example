# Copie para .env.local (nunca faça commit do .env.local)

# Conexão do Neon — use a string do POOLER (tem "-pooler" no host),
# que é a indicada para funções serverless da Vercel.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar a sessão de login.
# Gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET=""
