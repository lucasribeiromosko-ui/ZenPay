# Copie para .env.local (nunca faça commit do .env.local)

# Conexão do Neon — use a string do POOLER (tem "-pooler" no host),
# que é a indicada para funções serverless da Vercel.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar a sessão de login.
# Gere um valor aleatório com: openssl rand -base64 32
AUTH_SECRET=""

# ------------------------------------------------------------
# Mercado Pago — cobrança real de cartão via tokenização.
# Comece pelas credenciais de TESTE (prefixo TEST-).
#
# Public Key: vai no frontend, PODE ser exposta.
NEXT_PUBLIC_MP_PUBLIC_KEY=""
# Access Token: SEGREDO. Só no servidor. Nunca no frontend, nunca no git,
# nunca colado em chat. Se vazar, gere outro no painel do Mercado Pago.
MP_ACCESS_TOKEN=""

# ------------------------------------------------------------
# Área de admin (/admin). Só o e-mail lucasribeiromosko@gmail.com entra.
# Defina a senha aqui; sem ela, o login de admin não funciona.
ADMIN_PASSWORD=""
